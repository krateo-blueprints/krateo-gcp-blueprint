# renders a broken Marketplace card with nothing failing. Must also be the canonical org.
icon: "https://raw.githubusercontent.com/krateo-platformops/.github/main/brand/logo.svg"
keywords:
  - gcp
  - google-cloud
  - [[.Service]]
  - [[.Slug]]
  - config-connector
sources:
